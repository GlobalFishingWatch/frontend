{
  "name": "deck-loaders",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/deck-loaders/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "proto:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/src/vessels/lib/vessel-track-proto.gen.js",
        "{projectRoot}/src/vessels/lib/vessel-track-proto.gen.d.ts",
        "{projectRoot}/dist/vessels/lib/vessel-track-proto.gen.js",
        "{projectRoot}/dist/vessels/lib/vessel-track-proto.gen.d.ts"
      ],
      "options": {
        "cwd": "libs/deck-loaders",
        "commands": [
          "pbjs src/vessels/lib/vessel-track.proto -t static-module -w esm -r gfwDeckVessels -o src/vessels/lib/vessel-track-proto.gen.js",
          "pbts src/vessels/lib/vessel-track-proto.gen.js -o src/vessels/lib/vessel-track-proto.gen.d.ts",
          "prettier --write src/vessels/lib/vessel-track-proto.gen.js src/vessels/lib/vessel-track-proto.gen.d.ts --config ../../.prettierrc.js",
          "tsc --noEmit -p tsconfig.lib.json --tsBuildInfoFile ./tsconfig.check.tsbuildinfo",
          "shx mkdir -p dist/vessels/lib",
          "shx cp src/vessels/lib/vessel-track-proto.gen.js dist/vessels/lib/",
          "shx cp src/vessels/lib/vessel-track-proto.gen.d.ts dist/vessels/lib/"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["proto:generate", "^build"]
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --config=vitest.config.mts"
      }
    },
    "dist:workers": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{projectRoot}/dist/workers"],
      "options": {
        "command": "node libs/deck-loaders/scripts/build-workers.mjs"
      }
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build", "dist:workers"],
      "options": {
        "packageRoot": "libs/deck-loaders"
      }
    },
    "test:watch": {
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true
      }
    },
    "typecheck": {}
  }
}
