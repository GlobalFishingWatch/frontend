{
  "name": "timebar",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/timebar/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/timebar"
      ],
      "options": {
        "command": "vitest run --config=vitest.config.mts",
        "cwd": "libs/timebar",
        "coverage.reportsDirectory": "../../../coverage/libs/timebar"
      }
    },
    "dist": {
      "executor": "@nx/js:tsc",
      "options": {
        "clean": false,
        "assets": [
          {
            "glob": "**/*.css",
            "input": "libs/timebar/src",
            "output": "."
          }
        ]
      }
    },
    "dev": {
      "dependsOn": ["^dev"],
      "executor": "@nx/js:tsc",
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true
      }
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["dist"],
      "options": {
        "packageRoot": "libs/timebar"
      }
    }
  }
}
