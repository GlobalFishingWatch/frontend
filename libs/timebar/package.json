{
  "name": "@globalfishingwatch/timebar",
  "version": "5.0.14",
  "description": "GFW timebar",
  "homepage": "https://github.com/GlobalFishingWatch/frontend#readme",
  "author": "satellitestudio <contact@satellitestud.io>",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "development": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./timebar-settings.css": {
      "development": "./src/timebar-settings.css",
      "default": "./dist/timebar-settings.css"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@deck.gl/core": "9.x",
    "@deck.gl/extensions": "9.x",
    "@deck.gl/layers": "9.x",
    "@deck.gl/react": "9.x",
    "@deck.gl/widgets": "9.x",
    "@globalfishingwatch/api-types": "workspace:^",
    "@globalfishingwatch/data-transforms": "workspace:^",
    "@globalfishingwatch/dataviews-client": "workspace:^",
    "@globalfishingwatch/deck-layers": "workspace:^",
    "@globalfishingwatch/deck-loaders": "workspace:^",
    "@globalfishingwatch/ui-components": "workspace:^",
    "classnames": "2.x",
    "d3-array": "3.x",
    "d3-scale": "4.x",
    "d3-shape": "3.x",
    "es-toolkit": "1.x",
    "jotai": "2.x",
    "luxon": "3.x",
    "mjolnir.js": "3.x",
    "react": "19.x",
    "react-dom": "19.x",
    "tslib": "2.x"
  }
}
