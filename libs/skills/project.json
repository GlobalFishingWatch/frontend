{
  "name": "skills",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/skills/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "dist": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["^dist"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/skills/dist",
        "main": "libs/skills/src/index.ts",
        "additionalEntryPoints": [
          "libs/skills/src/encode-url/index.ts",
          "libs/skills/src/decode-url/index.ts"
        ],
        "tsConfig": "libs/skills/tsconfig.lib.json",
        "bundle": true,
        "format": ["esm"],
        "thirdParty": true,
        "declaration": false,
        "deleteOutputPath": true,
        "assets": [
          {
            "glob": "SKILL.md",
            "input": "libs/skills/src/encode-url",
            "output": "encode-url"
          },
          {
            "glob": "MAINTENANCE.md",
            "input": "libs/skills/src/encode-url",
            "output": "encode-url"
          },
          {
            "glob": "**/*",
            "input": "libs/skills/src/encode-url/scripts",
            "output": "encode-url/scripts"
          },
          {
            "glob": "**/*",
            "input": "libs/skills/src/encode-url/references",
            "output": "encode-url/references"
          },
          {
            "glob": "SKILL.md",
            "input": "libs/skills/src/decode-url",
            "output": "decode-url"
          },
          {
            "glob": "**/*",
            "input": "libs/skills/src/decode-url/scripts",
            "output": "decode-url/scripts"
          }
        ],
        "esbuildOptions": {
          "platform": "node",
          "outbase": "libs/skills/src",
          "banner": {
            "js": "import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);"
          },
          "alias": {
            "@platform/config": "./apps/platform/config/index.ts",
            "@globalfishingwatch/api-types": "./libs/api-types/dist/index.js",
            "@globalfishingwatch/api-client": "./libs/api-client/dist/index.js",
            "@globalfishingwatch/data-transforms": "./libs/data-transforms/dist/index.js",
            "@globalfishingwatch/deck-layers": "./libs/deck-layers/dist/layers/fourwings/fourwings.config.js",
            "@globalfishingwatch/deck-loaders": "./libs/deck-loaders/dist/index.js",
            "@globalfishingwatch/datasets-client": "./libs/datasets-client/dist/index.js",
            "@globalfishingwatch/dataviews-client": "./libs/dataviews-client/dist/index.js"
          }
        }
      }
    },
    "dev": {
      "dependsOn": ["^dev"],
      "executor": "@nx/js:tsc",
      "cache": false,
      "options": {
        "watch": true
      },
      "continuous": true
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["dist"],
      "options": {
        "packageRoot": "libs/skills"
      }
    },
    "claude:encode-url": {
      "executor": "nx:run-commands",
      "dependsOn": ["dist"],
      "options": {
        "command": "mkdir -p ~/.claude/skills && rm -rf ~/.claude/skills/encode-url && cp -r libs/skills/dist/encode-url ~/.claude/skills/"
      }
    },
    "claude:decode-url": {
      "executor": "nx:run-commands",
      "dependsOn": ["dist"],
      "options": {
        "command": "mkdir -p ~/.claude/skills && rm -rf ~/.claude/skills/decode-url && cp -r libs/skills/dist/decode-url ~/.claude/skills/"
      }
    }
  }
}
