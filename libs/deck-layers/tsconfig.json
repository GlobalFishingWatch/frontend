{
  "extends": "../tsconfig.lib.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // deck.gl layers override ~140 base-class members without the modifier. Opt out until
    // someone does that pass; the rest of the libs keep the flag from tsconfig.lib.base.json.
    "noImplicitOverride": false,
    "paths": {
      "#config": ["./src/config/index.ts"],
      "#utils": ["./src/utils/index.ts"],
      "#*": ["./src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
