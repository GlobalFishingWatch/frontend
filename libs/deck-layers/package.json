{
  "name": "@globalfishingwatch/deck-layers",
  "version": "0.1.7",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./draw": {
      "development": "./src/draw.ts",
      "types": "./dist/draw.d.ts",
      "default": "./dist/draw.js"
    },
    "./config": {
      "development": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./utils": {
      "development": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "imports": {
    "#config": {
      "development": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "#utils": {
      "development": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "#*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@deck.gl-community/editable-layers": "9.x",
    "@deck.gl/core": "9.x",
    "@deck.gl/extensions": "9.x",
    "@deck.gl/geo-layers": "9.x",
    "@deck.gl/layers": "9.x",
    "@globalfishingwatch/api-client": "workspace:^",
    "@globalfishingwatch/api-types": "workspace:^",
    "@globalfishingwatch/data-transforms": "workspace:^",
    "@globalfishingwatch/dataviews-client": "workspace:^",
    "@globalfishingwatch/deck-loaders": "workspace:^",
    "@loaders.gl/core": "4.x",
    "@loaders.gl/loader-utils": "4.x",
    "@loaders.gl/mvt": "4.x",
    "@loaders.gl/pmtiles": "4.x",
    "@loaders.gl/schema": "4.x",
    "@luma.gl/engine": "9.x",
    "@math.gl/core": "4.x",
    "@turf/turf": "7.x",
    "color-blend": "4.x",
    "d3-scale": "4.x",
    "es-toolkit": "1.x",
    "geojson": "0.x",
    "geokdbush": "2.x",
    "kdbush": "4.x",
    "luxon": "3.x",
    "qs": "6.x",
    "simple-statistics": "7.x",
    "supercluster": "9.x",
    "tslib": "2.x"
  }
}
