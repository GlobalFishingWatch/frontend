{
  "name": "deck-layers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/deck-layers/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "dist": {
      "executor": "@nx/js:tsc",
      "options": {
        "clean": false
      }
    },
    "test": {
      "dependsOn": ["^dist"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --config=vitest.config.mts"
      }
    },
    "test:watch": {
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true,
        "config": "./vitest.config.mts"
      }
    },
    "typecheck": {},
    "publish": {}
  }
}
