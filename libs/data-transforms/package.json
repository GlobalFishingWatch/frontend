{
  "name": "@globalfishingwatch/data-transforms",
  "version": "4.0.1",
  "description": "Utils to decode various data formats",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dates": {
      "development": "./src/dates/index.ts",
      "types": "./dist/dates/index.d.ts",
      "default": "./dist/dates/index.js"
    },
    "./*": {
      "development": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@developmentseed/geotiff": "0.x",
    "@globalfishingwatch/api-types": "workspace:^",
    "@globalfishingwatch/datasets-client": "workspace:^",
    "@globalfishingwatch/deck-loaders": "workspace:^",
    "@tmcw/togeojson": "7.x",
    "@turf/turf": "7.x",
    "es-toolkit": "1.x",
    "geo-coordinates-parser": "1.x",
    "geojson": "0.x",
    "geotiff": "3.x",
    "jszip": "3.x",
    "luxon": "3.x",
    "proj4": "2.x",
    "shpjs": "6.x",
    "tslib": "2.x"
  }
}
