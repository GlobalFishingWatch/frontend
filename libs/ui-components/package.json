{
  "name": "@globalfishingwatch/ui-components",
  "version": "14.0.9",
  "description": "Set of react components to consume on the gfw ecosystem",
  "license": "MIT",
  "repository": "github:GlobalFishingWatch/frontend",
  "homepage": "https://github.com/GlobalFishingWatch/frontend#readme",
  "author": "satellitestudio <contact@satellitestud.io>",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.css": "./src/base.css",
    "./dom-ids": {
      "development": "./src/dom-ids.ts",
      "types": "./dist/dom-ids.d.ts",
      "default": "./dist/dom-ids.js"
    },
    "./color-bar-options": {
      "development": "./src/color-bar/color-bar-options.ts",
      "types": "./dist/color-bar/color-bar-options.d.ts",
      "default": "./dist/color-bar/color-bar-options.js"
    },
    "./*": {
      "development": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prerender": "ts-node -P tsconfig.node.json src/header/render-html.tsx"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@floating-ui/react": "0.x",
    "@globalfishingwatch/api-types": "workspace:^",
    "@globalfishingwatch/react-hooks": "workspace:^",
    "@tanstack/react-virtual": "3.x",
    "@types/topojson-specification": "1.x",
    "classnames": "2.x",
    "d3-format": "3.x",
    "d3-geo": "3.x",
    "d3-scale": "4.x",
    "downshift": "9.x",
    "luxon": "3.x",
    "match-sorter": "8.x",
    "react": "19.x",
    "react-aria-components": "1.x",
    "react-dom": "19.x",
    "suncalc": "2.0.1",
    "topojson-client": "3.x",
    "tslib": "2.x"
  }
}
