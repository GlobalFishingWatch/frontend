{
  "extends": "../tsconfig.lib.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // customConditions resolves deck-layers from src, so its unmodified deck.gl overrides
    // are checked under this project's options too. See libs/deck-layers/tsconfig.json.
    "noImplicitOverride": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
