{
  "name": "dataviews-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/dataviews-client/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "dist": {
      "executor": "@nx/js:tsc",
      "options": {
        "clean": false
      }
    },
    "dev": {
      "dependsOn": ["^dev"],
      "executor": "@nx/js:tsc",
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true
      }
    },
    "bundle-url-workspace": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}libs/dataviews-client/src/url-workspace"],
      "dependsOn": [],
      "options": {
        "commands": ["node libs/dataviews-client/esbuild.url.ts"],
        "cwd": "."
      }
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["dist"],
      "options": {
        "packageRoot": "libs/dataviews-client"
      }
    },
    "test": {
      "dependsOn": ["^dist"],
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/dataviews-client"
      ],
      "options": {
        "command": "vitest run --config=vitest.config.mts",
        "coverage.reportsDirectory": "../../../coverage/libs/dataviews-client"
      }
    },
    "test:watch": {
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true,
        "config": "./vitest.config.ts"
      }
    }
  }
}
