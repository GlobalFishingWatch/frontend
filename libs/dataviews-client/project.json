{
  "name": "dataviews-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/dataviews-client/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc"
    },
    "bundle-url-workspace": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/dataviews-client/src/url-workspace/url-workspace.js"],
      "dependsOn": [],
      "options": {
        "commands": ["node libs/dataviews-client/esbuild.url.ts"],
        "cwd": "."
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --config=vitest.config.mts"
      }
    },
    "test:watch": {
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true
      }
    },
    "typecheck": {},
    "publish": {}
  }
}
