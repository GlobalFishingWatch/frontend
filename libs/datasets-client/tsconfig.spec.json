{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "tsBuildInfoFile": "./tsconfig.spec.tsbuildinfo",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "moduleResolution": "bundler"
  },
  "include": [
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
