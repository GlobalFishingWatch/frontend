{
  "name": "datasets-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/datasets-client/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "dist": {
      "executor": "@nx/js:tsc",
      "options": {
        "clean": false
      }
    },
    "dev": {
      "dependsOn": ["^dev"],
      "executor": "@nx/js:tsc",
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true
      }
    },
    "test": {
      "dependsOn": ["^dist"],
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/datasets-client"
      ],
      "options": {
        "command": "vitest run --config=vitest.config.mts",
        "coverage.reportsDirectory": "../../../coverage/libs/datasets-client"
      }
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["dist"],
      "options": {
        "packageRoot": "libs/datasets-client"
      }
    }
  }
}
