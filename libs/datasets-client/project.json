{
  "name": "datasets-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/datasets-client/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "dist": {
