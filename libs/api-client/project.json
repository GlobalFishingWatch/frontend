{
  "name": "api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-client/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "proto:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^dist"],
      "inputs": ["{projectRoot}/src/pbf-decoders/vessels.proto", "{workspaceRoot}/.prettierrc.js"],
      "outputs": [
        "{projectRoot}/src/pbf-decoders/vessels.gen.js",
        "{projectRoot}/src/pbf-decoders/vessels.gen.d.ts",
        "{projectRoot}/dist/pbf-decoders"
      ],
      "options": {
        "cwd": "libs/api-client",
        "commands": [
          "pbjs src/pbf-decoders/vessels.proto -t static-module -w esm -r gfwApiVessels -o src/pbf-decoders/vessels.gen.js",
          "pbts src/pbf-decoders/vessels.gen.js -o src/pbf-decoders/vessels.gen.d.ts",
          "prettier --write src/pbf-decoders/vessels.gen.js src/pbf-decoders/vessels.gen.d.ts --config ../../.prettierrc.js",
          "tsc --noEmit -p tsconfig.lib.json --tsBuildInfoFile ./tsconfig.check.tsbuildinfo",
          "shx mkdir -p dist/pbf-decoders",
          "shx cp src/pbf-decoders/vessels.gen.js dist/pbf-decoders/",
          "shx cp src/pbf-decoders/vessels.gen.d.ts dist/pbf-decoders/"
        ],
        "parallel": false
      }
    },
    "dist": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["proto:generate"],
      "options": {
        "clean": false
      }
    },
    "dev": {
      "dependsOn": ["^dev"],
      "executor": "@nx/js:tsc",
      "cache": false,
      "options": {
        "watch": true
      },
      "continuous": true
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["dist"],
      "options": {
        "packageRoot": "libs/api-client"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["^dist"],
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "command": "vitest run --config=vitest.config.ts",
        "reportsDirectory": "{projectRoot}/../../coverage/libs/api-client"
      }
    },
    "test:watch": {
      "executor": "@nx/vitest:test",
      "cache": false,
      "options": {
        "configFile": "libs/api-client/vitest.config.ts",
        "watch": true
      },
      "continuous": true
    }
  }
}
