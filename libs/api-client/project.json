{
  "name": "api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-client/src",
  "projectType": "library",
  "tags": ["lib"],
  "targets": {
    "proto:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^dist"],
      "inputs": ["{projectRoot}/src/pbf-decoders/vessels.proto", "{workspaceRoot}/.prettierrc.js"],
      "outputs": [
        "{projectRoot}/src/pbf-decoders/vessels.gen.js",
        "{projectRoot}/src/pbf-decoders/vessels.gen.d.ts",
        "{projectRoot}/dist/pbf-decoders/vessels.gen.js",
        "{projectRoot}/dist/pbf-decoders/vessels.gen.d.ts"
      ],
      "options": {
        "cwd": "libs/api-client",
        "commands": [
          "pbjs src/pbf-decoders/vessels.proto -t static-module -w esm -r gfwApiVessels -o src/pbf-decoders/vessels.gen.js",
          "pbts src/pbf-decoders/vessels.gen.js -o src/pbf-decoders/vessels.gen.d.ts",
          "prettier --write src/pbf-decoders/vessels.gen.js src/pbf-decoders/vessels.gen.d.ts --config ../../.prettierrc.js",
          "tsc --noEmit -p tsconfig.lib.json --tsBuildInfoFile ./tsconfig.check.tsbuildinfo",
          "shx mkdir -p dist/pbf-decoders",
          "shx cp src/pbf-decoders/vessels.gen.js dist/pbf-decoders/",
          "shx cp src/pbf-decoders/vessels.gen.d.ts dist/pbf-decoders/"
        ],
        "parallel": false
      }
    },
    "dist": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["proto:generate"],
      "options": {
        "clean": false,
        "assets": [
          {
            "input": "libs/api-client/src/pbf-decoders",
            "glob": "vessels.gen.{js,d.ts}",
            "output": "pbf-decoders"
          }
        ]
      }
    },
    "test": {
      "dependsOn": ["^dist"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --config=vitest.config.mts"
      }
    },
    "test:watch": {
      "cache": false,
      "continuous": true,
      "options": {
        "watch": true
      }
    },
    "typecheck": {},
    "publish": {}
  }
}
