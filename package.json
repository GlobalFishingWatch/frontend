  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "release:fishing-map": "nx release --projects='fishing-map' --skip-publish",
    "affected": "nx show projects --affected --base=origin/develop~1 --exclude='linting,port-labeler,*-e2e,libs/*' --plain > affected-apps.txt",
    "affected:libs": "nx show projects --affected --base=origin/develop~1 --exclude='apps/*' --plain > affected-libs.txt",
    "test:apps": "nx run-many -t test --exclude='libs/*'",
    "test:libs": "nx run-many -t test --exclude='apps/*'",
    "postinstall": "husky",
    "nx:latest": "nx migrate latest",
    "nx:migrations": "nx migrate --run-migrations",
    "knip": "NX_DAEMON=false knip",
    "knip:fix": "NX_DAEMON=false knip --fix",
    "libs:dev": "nx run-many -t dev --projects=tag:lib",
    "clean": "pnpm clean:cache && pnpm clean:deps",
    "clean:deps": "rimraf -rf ./pnpm-lock.yaml && touch pnpm-lock.yaml && rimraf -rf ./node_modules && pnpm store prune && pnpm install",
    "clean:cache": "rimraf -rf .nx && rimraf -rf ./dist",
    "purge": "node scripts/purge-css.js"
  },
