{
  "name": "api-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-portal/src",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/apps/api-portal"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/apps/api-portal"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    }
  }
}
