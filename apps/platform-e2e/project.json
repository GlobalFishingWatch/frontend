{
  "name": "platform-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/platform-e2e/src",
  "projectType": "application",
  "tags": ["e2e"],
  "implicitDependencies": ["platform"],
  "targets": {
    "test": {
      "cache": false,
      "dependsOn": [],
      "configurations": {
        "smoke": {
          "grep": "@smoke",
          "project": "chromium"
        },
        "extended": {
          "grep": "@smoke|@extended",
          "env": {
            "PLAYWRIGHT_BROWSER": "all"
          }
        },
        "regression": {
          "env": {
            "PLAYWRIGHT_BROWSER": "all"
          }
        }
      }
    },
    "test:local": {
      "cache": false,
      "parallelism": true,
      "configurations": {
        "ui": {
          "ui": true
        },
        "headed": {
          "headed": true
        },
        "smoke": {
          "grep": "@smoke",
          "project": "chromium"
        },
        "extended": {
          "grep": "@smoke|@extended",
          "env": {
            "PLAYWRIGHT_BROWSER": "all"
          }
        },
        "regression": {
          "env": {
            "PLAYWRIGHT_BROWSER": "all"
          }
        }
      }
    },
    "screenshots": {
      "cache": false,
      "options": {
        "project": "chromium",
        "workers": 2,
        "env": {
          "PLAYWRIGHT_SCREENSHOTS": "true"
        }
      },
      "configurations": {
        "update": {
          "update-snapshots": "changed"
        },
        "ui": {
          "workers": 1,
          "ui": true
        }
      }
    },
    "show-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright show-report {projectRoot}/playwright-report"
      }
    },
    "screenshots:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report apps/platform-e2e/playwright-report"
      }
    }
  }
}
