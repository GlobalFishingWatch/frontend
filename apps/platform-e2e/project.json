{
  "name": "platform-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/platform-e2e/src",
  "projectType": "application",
  "tags": ["e2e"],
  "implicitDependencies": ["platform"],
  "targets": {
    "test": {
      "options": {
        "grep": "^(?!.*Screenshot comparison).*"
      }
    },
    "test:local": {
      "command": "playwright test",
      "cache": false,
      "dependsOn": [
        {
          "projects": "platform",
          "target": "start"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "grep": "^(?!.*Screenshot comparison).*"
      },
      "configurations": {
        "ui": {
          "ui": true
        },
        "headed": {
          "headed": true
        }
      }
    },
    "screenshots": {
      "command": "playwright test src/screenshots/ --project=chromium --workers=2",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "update": {
          "command": "playwright test src/screenshots/ --project=chromium --workers=2 --update-snapshots"
        },
        "ui": {
          "command": "playwright test src/screenshots/ --project=chromium --workers=1 --ui"
        }
      }
    },
    "screenshots:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report apps/platform-e2e/playwright-report"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project apps/platform-e2e/tsconfig.json"
      }
    },
    "typecheck-watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --watch --project apps/platform-e2e/tsconfig.json"
      },
      "continuous": true
    }
  }
}
