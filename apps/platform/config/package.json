{
  "name": "@platform/config",
  "version": "1.0.0",
  "description": "platform app configuration constants, shared as source (no build) inside the monorepo",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./routes": {
      "types": "./routes.ts",
      "default": "./routes.ts"
    },
    "./map/app": {
      "types": "./map/app.ts",
      "default": "./map/app.ts"
    },
    "./map/dataviews": {
      "types": "./map/dataviews.ts",
      "default": "./map/dataviews.ts"
    },
    "./map/workspaces": {
      "types": "./map/workspaces.ts",
      "default": "./map/workspaces.ts"
    }
  },
  "dependencies": {
    "@globalfishingwatch/datasets-client": "workspace:^"
  }
}
