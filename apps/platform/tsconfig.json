{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node",
      "vite/client",
      "vitest",
      "vitest-browser-react",
      "@vitest/browser/matchers",
      "@vitest/browser-playwright"
    ],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "strictNullChecks": true,
    // generating source maps for debug ids for Sentry.
    "sourceMap": true,
    "paths": {
      "assets/*": ["./assets/*"],
      "data/*": ["./data/*"],
      "features/*": ["./features/*"],
      "hooks/*": ["./hooks/*"],
      "middlewares": ["./store/middlewares"],
      "pages/*": ["./pages/*"],
      "queries": ["./queries"],
      "queries/*": ["./queries/*"],
      "reducers": ["./store/reducers"],
      "router/*": ["./router/*"],
      "routes/*": ["./routes/*"],
      "server/*": ["./server/*"],
      "server-functions/*": ["./server-functions/*"],
      "store": ["./store/store"],
      "test/*": ["./test/*"],
      "types": ["./types"],
      "types/*": ["./types/*"],
      "utils/*": ["./utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": [
    "node_modules",
    ".next",
    "jest.config.ts",
    "exported",
    "**/resources.d.ts",
    "**/__traces__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
