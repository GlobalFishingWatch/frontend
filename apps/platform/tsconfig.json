{
  "$comment": "Sources live at the app root, not under src/, so include and exclude override the shared base.",
  "extends": "../tsconfig.apps.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/platform.tsbuildinfo",
    "paths": {
      "assets/*": ["./assets/*"],
      "data/*": ["./data/*"],
      "features/*": ["./features/*"],
      "hooks/*": ["./hooks/*"],
      "middlewares": ["./store/middlewares"],
      "pages/*": ["./pages/*"],
      "queries": ["./queries"],
      "queries/*": ["./queries/*"],
      "reducers": ["./store/reducers"],
      "router/*": ["./router/*"],
      "routes/*": ["./routes/*"],
      "server/*": ["./server/*"],
      "server-functions/*": ["./server-functions/*"],
      "store": ["./store/store"],
      "test/*": ["./test/*"],
      "types": ["./types"],
      "types/*": ["./types/*"],
      "utils/*": ["./utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "exported",
    ".output",
    ".tanstack",
    "**/__traces__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
