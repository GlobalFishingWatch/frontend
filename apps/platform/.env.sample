# Basic auth for restricted environments (set BASIC_AUTH=restricted to enable)
# BASIC_AUTH=restricted
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

i18n_DEBUG=true
SPREADSHEET_CLIENT_EMAIL=
SPREADSHEET_PRIVATE_KEY=
DOWNLOAD_SURVEY_SPREADSHEET_ID=
FEEDBACK_SPREADSHEET_ID=
MAP_ERRORS_SPREADSHEET_ID=
IDENTITY_REVIEW_SPREADSHEET_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_MEASUREMENT_ID=
USE_LOCAL_DATAVIEWS=true
USE_LOCAL_DATASETS=true
WORKSPACE_ENV=development

VITE_API_GATEWAY=https://gateway.api.dev.globalfishingwatch.org

# Cloudflare Turnstile widget that resets the track/events rate limit.
# 1x00000000000000000000AA is Cloudflare's always-pass test sitekey.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Local mock until the API ships the rate limit: count track/events requests client-side
# and reset through routes/api/rate-limit/reset.ts, which verifies the token with this secret.
# Server-only, never VITE_-prefixed. Get it from the Cloudflare dashboard.
VITE_RATE_LIMIT_MOCK_LIMIT=10
VITE_RATE_LIMIT_RESET_URL=/platform/api/rate-limit/reset
# GFWAPI debug logs: true (all), request (fetches), auth (tokens/login/session) or rate-limit (rate limit + Turnstile)
VITE_DEBUG_API_REQUESTS=rate-limit

VITE_PLATFORM_MODE=false

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Server-only (no VITE_ prefix) — never exposed to the client bundle
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
STRAPI_PREVIEW_SECRET=
# Production CMS, read by `nx run platform:user-guide:sync`
STRAPI_URL_PRO=
STRAPI_TOKEN_PRO=

