{
  "name": "data-download-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/data-download-portal/src",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/apps/data-download-portal"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/apps/data-download-portal"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vite",
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
