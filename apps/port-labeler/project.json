{
  "name": "port-labeler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/port-labeler/src",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/apps/port-labeler"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/apps/port-labeler"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "start": {
      "dependsOn": [{ "projects": ["i18n-labels"], "target": "serve", "waitFor": "ready" }]
    }
  }
}
