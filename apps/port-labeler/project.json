{
  "name": "port-labeler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/port-labeler/src",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "watch-deps": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "nx watch --projects port-labeler --includeDependencies -- nx run-many -t build -p \\$NX_PROJECT_NAME --exclude=port-labeler"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx build port-labeler --parallel"
      }
    },
    "build": {
      "dependsOn": ["^build", "^dist"],
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/apps/port-labeler"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/apps/port-labeler"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["nx serve i18n-labels", "vite"],
        "cwd": "{projectRoot}",
        "parallel": true
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
